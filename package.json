{
  "name": "capa-wallet",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:personal": "vite --mode personal --port=3000 --host=0.0.0.0",
    "build": "vite build",
    "build:personal": "vite build --mode personal",
    "deploy": "pnpm build && wrangler pages deploy dist --project-name capa-wallet",
    "deploy:personal": "node --experimental-strip-types scripts/deploy-personal.ts",
    "preview": "vite preview",
    "preview:personal": "vite preview --mode personal",
    "clean": "rm -rf dist dist-personal server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "^6.1.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "^3.7.0",
    "vite": "^8.3.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "wrangler": "^4.152.0"
  }
}
